# ==============================================================
# FreelanceFlow Backend Environment Variables (Template)
# ==============================================================

# MongoDB Connection String (Atlas or Local)
SPRING_DATA_MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/freelanceflow?retryWrites=true&w=majority

# Application Server Port
PORT=8081

# JWT Signing Secret (256-bit Hex)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Deliverable Upload Directory
UPLOAD_DIR=uploads
